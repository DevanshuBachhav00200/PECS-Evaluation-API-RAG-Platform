# ==========================================
# PECS Evaluation RAG API Configuration
# ==========================================
#
# Copy to .env and fill in. .env is gitignored (FOUND-003) and dockerignored
# (DEP-006), so a real credential never reaches the repository or an image layer.
#
# DEP-002 — this file is the contract for containerized runs. Every variable the
# container reads is listed here, and `docker run --env-file .env` is the only
# supported way to supply them. Verified by
# `pytest tests/member6/test_deployment.py` and, with a Docker engine present,
# `python -m scripts.verify_container --check-secrets`.

# ------------------------------------------------------------------
# Required — the service refuses to serve /evaluate without these
# ------------------------------------------------------------------

# Evaluator credential. Without it, the first /evaluate call returns
# RAG_LLM_AUTH_ERROR (mapped to HTTP 502).
ANTHROPIC_API_KEY=

# Server-side secret clients must send as the x-api-key header (API-007).
# Leave unset and /evaluate fails closed with HTTP 500 — never open.
API_KEY=

# ------------------------------------------------------------------
# Embedding Model
# ------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Pre-baked model cache inside the image (DEP-005). Leave as-is for container
# runs; unset it for a local checkout to use the default HuggingFace cache.
# HF_HOME=/opt/hf-cache
# HF_HUB_OFFLINE=1

# ------------------------------------------------------------------
# ChromaDB
# ------------------------------------------------------------------
# NOTE: the live vector store path is CHROMA_DB_PATH, further down. The two
# settings below are read by neither the RAG layer nor the vector store; they
# are retained from the original scaffold and are tracked for removal in
# docs/known_issues_and_limitations.md.
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=pecs_evaluation

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
API_HOST=0.0.0.0

# Local (bare uvicorn) listen port. The container listens on PECS_API_PORT
# (default 9000, per DEP-001) — set that, not this, for containerized runs.
API_PORT=8000
PECS_API_PORT=9000

# Base URL used by the benchmark harness in --mode http (BENCH-004).
PECS_API_URL=http://localhost:9000

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ==========================================
# RAG + Evaluation engine (Member 4)
# Every value below is optional — the defaults
# shown are what src/rag/config.py uses.
# ==========================================

# Vector store location used by the RAG layer (VDB-001)
CHROMA_DB_PATH=Database/pels_vector_db

# Evaluator model. Dated snapshot, not the alias, so scoring cannot change
# under us when an alias is repointed (see docs/evaluator_determinism.md).
PECS_EVALUATOR_MODEL=claude-haiku-4-5-20251001
PECS_EVALUATOR_MAX_TOKENS=4096
PECS_EVALUATOR_TEMPERATURE=0.0

# Retrieval: calibration examples per candidate prompt (MVP default 1)
PECS_RAG_TOP_K=1

# Prompt assembly and token safety
PECS_MAX_PROMPT_CHARS=1000
PECS_CHARS_PER_TOKEN=3.5
PECS_TOKEN_SAFETY_CAP=4000

# Retry budget for malformed evaluator responses (1 initial + retries)
PECS_MAX_LLM_ATTEMPTS=3

# Mark the rubric system block for ephemeral prompt caching
PECS_ENABLE_PROMPT_CACHING=true

# Out-of-range evaluator scores: reject | clamp
PECS_SCORE_RANGE_MODE=reject

# Output shaping
PECS_JUSTIFICATION_WORD_CAP=40
PECS_SUMMARY_WORD_CAP=60

# C5 ethics handling. Leave false until Team Beta / Alliance Compliance
# confirm in writing that the hard-gate veto is active (EVAL-008).
PECS_ETHICS_HARD_GATE=false
PECS_ETHICS_GATE_THRESHOLD=3.0
PECS_ETHICS_GATE_CAPPED_SCORE=3.99

# Evaluator pricing used for the per-call cost audit line (USD per 1M tokens)
PECS_PRICE_INPUT_PER_MTOK=1.00
PECS_PRICE_OUTPUT_PER_MTOK=5.00